# Ensure all .attheme files always maintain Unix LF line endings
*.attheme text eol=lf
*.dat binary
*.gzip binary
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf

# Защита локальных нативных исходников C++ NDK и .gitmodules от удаления апстримом (DrKLO)
TMessagesProj/jni/** merge=ours
.gitmodules merge=ours
